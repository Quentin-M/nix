# Base module
zmodule environment
zmodule input

# Syntax highlighting.
## Its only `uname` use is `$(uname -a) == (#i)*darwin*`: answer from $OSTYPE, skip the exec.
zmodule zdharma-continuum/fast-syntax-highlighting \
  --cmd 'uname() { print -r -- $OSTYPE }; source {}/fast-syntax-highlighting.plugin.zsh; unfunction uname'

# Completion

## moooooore completions (fpath only, must be before completion)
zmodule zsh-users/zsh-completions
## activate!
zmodule completion

## Calls compinit internally, so it must come after completion.
## (mise, starship, zoxide, atuin, direnv init is cached in zshrc.)
zmodule joke/zim-kubectl

## autosuggestions when typing
zmodule zsh-users/zsh-autosuggestions
## up/down-arrows-driven CTRL-R
zmodule zsh-users/zsh-history-substring-search

## fzf-driven completion
zmodule Aloxaf/fzf-tab
